{
  "UrlProxy": "",
  "LogApi": "",
  "LogApiKey": "",
  "WebmasterEmail": "post@norgedigitalt.no",
  "SmtpHost": "",
  "FilePath": "",
  "BaatAuthzApiCredentials": "",
  "BuildVersionNumber": "1.0.0-dev",
  "EnvironmentName": "dev",
  "ProxyAddress": "",
  "RedirectUri": "",
  "PostLogoutRedirectUri": "",
  "Urls": {
    "GeonorgeRoot": "https://www.test.geonorge.no/",
    "BaatAuthzApi": ""
  },
  "auth": {
    "oidc": {
      "authority": "",
      "clientid": "",
      "clientsecret": "",
      "metadataaddress": "",
      "issuer": "",
      "IntrospectionUrl": "https://test2.geoid.no/realms/geoid/protocol/openid-connect/token/introspect"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "c:\\inetpub\\logs\\Minside.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{SourceContext}] [{Level}] [{MachineName}] [{ThreadId}] {Message}{NewLine}{Exception}",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{SourceContext}] [{Level}] [{MachineName}] [{ThreadId}] {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Geonorge.MinSide"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.\\SQLEXPRESS;Initial Catalog=kartverket_organization;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  }
}
